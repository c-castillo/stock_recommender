<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily run: 10:45 Chile time, Monday to Saturday. New York opens at 11:30
  Chile time from November to mid-March, at 10:30 in the weeks when only one of
  the two is on summer time, and at 09:30 from April to September, so this start
  is before the open only part of the year. Saturday's run is the weekly review
  on Friday's closes.

  Install or remove with scripts/scheduled-run.sh (install / remove flags).
  launchd runs a missed start when the Mac wakes; to have it wake by itself,
  ten seconds before the start (the Mac goes back to idle sleep about a minute
  after a scheduled wake, so an earlier wake is asleep again by 10:45):
    sudo pmset repeat wakeorpoweron MTWRFS 10:44:50
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stock-recommender.daily-run</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/cristobalcastillo/stock_recommender/scripts/scheduled-run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/cristobalcastillo/stock_recommender</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/cristobalcastillo/stock_recommender/.whatsapp/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cristobalcastillo/stock_recommender/.whatsapp/logs/launchd.log</string>
</dict>
</plist>
